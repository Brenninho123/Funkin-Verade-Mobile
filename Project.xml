<?xml version="1.0" encoding="utf-8"?>
<project>
	<app title="Funkin' em Verade" file="TonhoFunkin" package="com.avalanche.veradefunkin" packageName="com.avalanche.veradefunkin" main="Main" version="1.0.0-demo" company="Avalanche_Prods" />

	<app preloader="flixel.system.FlxPreloader" />

	<set name="SWF_VERSION" value="11.8" />

	<define name="EDITORS_ALLOWED" if="desktop debug" />
	<define name="HSCRIPT_ALLOWED" unless="web" />
	<define name="LUA_ALLOWED" unless="web" />
	<define name="ACHIEVEMENTS_ALLOWED" />
	<define name="DISCORD_ALLOWED" if="cpp"/>
	<define name="TRANSLATIONS_ALLOWED" unless="DEMO" />
	<define name="VIDEOS_ALLOWED" if="windows || linux || android || mac" unless="32"/>

	<define name="MULTITHREADED_LOADING" unless="ios || 32" />
	<define name="SHOW_LOADING_SCREEN" />

	<define name="IRIS_DEBUG" if="HSCRIPT_ALLOWED"/>
	<haxedef name="LINC_LUA_RELATIVE_DYNAMIC_LIB" if="LUA_ALLOWED"/>

	<window width="1280" height="720" fps="60" background="#000000" hardware="true" vsync="false" allow-high-dpi="true" />

	<window if="desktop" orientation="landscape" fullscreen="false" resizable="true"/>

	<window if="mobile" orientation="landscape" fullscreen="true" resizable="false" allow-high-dpi="false"/>
	<window if="android" antialiasing="0" />
	<window if="ios" antialiasing="0" />

	<set name="BUILD_DIR" value="export/debug" if="debug" />
	<set name="BUILD_DIR" value="export/release" if="release" />
	<set name="BUILD_DIR" value="export/32bit" if="32" />
	<classpath name="source" />

	<define name="CRASH_HANDLER" if="release" />
	<define name="CHECK_FOR_UPDATES" if="desktop"/>

	<assets path="assets/fonts"/>
	<assets path="assets/shared"/>
	<assets path="assets/embed" embed="true"/>
	<assets path="assets/videos" if="VIDEOS_ALLOWED"/>
	<assets path="assets/songs"/>
	<assets path="assets/week_assets" rename="assets"/>
	<assets path="assets/translations" rename="assets" if="TRANSLATIONS_ALLOWED"/>

	<section if="desktop">
		<assets path="alsoft.txt" rename="plugins/alsoft.ini" type="text" if="windows"/>
		<assets path="alsoft.txt" rename="plugins/alsoft.conf" type="text" unless="windows"/>
	</section>

	<haxelib name="flixel"/>
	<haxelib name="flixel-addons"/>
	<haxelib name="tjson" version="1.4.0"/>
	<haxelib name="hxcpp-debug-server" if="debug desktop"/>

	<haxelib name="linc_luajit" if="LUA_ALLOWED"/>
	<haxelib name="hscript-iris" if="HSCRIPT_ALLOWED" version="1.1.3"/>
	<haxelib name="hxvlc" if="VIDEOS_ALLOWED" version="2.0.1"/>
	<haxelib name="hxdiscord_rpc" if="DISCORD_ALLOWED" version="1.2.4"/>
	<haxelib name="flxanimate"/>
	<haxelib name="extension-androidtools" if="android"/>

	<haxedef name="DISCORD_DISABLE_IO_THREAD" if="hxdiscord_rpc" />
	<haxedef name="NO_PRECOMPILED_HEADERS" if="linux" />

	<haxedef name="HXC_LIBVLC_LOGGING" if="VIDEOS_ALLOWED debug" />
	<haxedef name="HXVLC_NO_SHARE_DIRECTORY" if="VIDEOS_ALLOWED" />
	<haxedef name="hscriptPos" if="HSCRIPT_ALLOWED" />

	<haxedef name="FLX_NO_TOUCH" if="desktop" />
	<haxedef name="FLX_NO_FOCUS_LOST_SCREEN" />
	<haxedef name="FLX_NO_DEBUG" if="release" />
	<haxedef name="NAPE_RELEASE_BUILD" if="release" />

	<haxedef name="HXCPP_CHECK_POINTER" if="CRASH_HANDLER" />
	<haxedef name="HXCPP_STACK_LINE" if="CRASH_HANDLER" />
	<haxedef name="HXCPP_STACK_TRACE" if="CRASH_HANDLER" />

	<define name="HXCPP_M32" if="32"/>

	<haxedef name="message.reporting" value="pretty" />

	<haxeflag name="--macro" value="allowPackage('flash')" />
	<haxeflag name="--macro" value="include('states', true, ['states.stages.Template'])" />

	<config:android install-location="auto" target-sdk-version="34" min-sdk-version="21" application-directory="funkin" if="android"/>
	<config:android architectures="armv7 arm64" if="android"/>
	<config:android permissions="android.permission.INTERNET android.permission.VIBRATE android.permission.WRITE_EXTERNAL_STORAGE android.permission.READ_EXTERNAL_STORAGE" if="android"/>

	<config:ios device="universal" deployment="12.0" binary-embed="true" if="ios"/>

	<icon path="icon.png" if="android || ios"/>
	<assets path="icon.png" if="linux || mac" />
	<icon path="icon.png"/>
</project>
